{
  "name": "@trodad/rich-text-editor",
  "version": "1.0.0",
  "description": "A Plate-based rich text editor that reads and writes HTML or Plate JSON, and takes a paste from Word, Excel or LibreOffice without losing tables, fonts or spacing. Works as a React component, an HTML form element, or a script-tag mount for server-rendered pages.",
  "keywords": [
    "rich-text-editor",
    "wysiwyg",
    "editor",
    "plate",
    "slate",
    "react",
    "html",
    "json",
    "word",
    "docx",
    "paste",
    "web-component",
    "form"
  ],
  "license": "MIT",
  "author": "Trodad",
  "homepage": "https://github.com/trodad-intl/rich-text-editor#readme",
  "bugs": {
    "url": "https://github.com/trodad-intl/rich-text-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trodad-intl/rich-text-editor.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/standalone/**",
    "./dist/element.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mount": {
      "types": "./dist/types/mount.d.ts",
      "import": "./dist/mount.js"
    },
    "./element": {
      "types": "./dist/types/element-define.d.ts",
      "import": "./dist/element.js"
    },
    "./standalone": {
      "types": "./dist/types/standalone.d.ts",
      "import": "./dist/standalone/rich-text-editor.js"
    },
    "./style.css": "./dist/rich-text-editor.css",
    "./style.bootstrap.css": "./dist/rich-text-editor.bootstrap.css",
    "./content.css": "./dist/content.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm build:clean && pnpm build:lib && pnpm build:standalone && pnpm build:css && pnpm build:types",
    "build:clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:lib": "vite build",
    "build:standalone": "vite build --config vite.standalone.config.ts",
    "build:css": "node build/build-css.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "dev": "vite --config playground/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:browser",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:browser": "playwright test",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@platejs/basic-nodes": "52.3.10",
    "@platejs/basic-styles": "52.3.10",
    "@platejs/caption": "52.3.10",
    "@platejs/dnd": "52.3.16",
    "@platejs/docx": "52.3.10",
    "@platejs/floating": "52.3.10",
    "@platejs/indent": "52.3.10",
    "@platejs/juice": "52.3.10",
    "@platejs/link": "52.3.17",
    "@platejs/list": "52.3.10",
    "@platejs/list-classic": "52.3.10",
    "@platejs/media": "52.3.10",
    "@platejs/resizable": "52.3.10",
    "@platejs/selection": "52.3.10",
    "@platejs/table": "52.3.20",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-toolbar": "1.1.11",
    "@radix-ui/react-tooltip": "1.2.8",
    "@udecode/cn": "52.3.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lodash": "4.18.1",
    "lucide-react": "0.482.0",
    "mammoth": "^1.12.2",
    "platejs": "52.3.21",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "use-file-picker": "2.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/cli": "^4.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash": "^4.17.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
